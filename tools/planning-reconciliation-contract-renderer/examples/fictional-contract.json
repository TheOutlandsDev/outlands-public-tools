  "counting_rules": [
    {
      "rule_id": "COUNT-001",
      "title": "Effective WIP",
      "expression": "Effective WIP = Current observed live WIP plus team-cleared stock awaiting sync.",
      "explanation": "Review the documented quantities."
    },
    {
      "rule_id": "COUNT-002",
      "title": "Voided order",
      "expression": "Voided order row -> zero demand.",
      "explanation": "A voided entry contributes no demand."
    },
    {
      "rule_id": "COUNT-003",
      "title": "Eligible allocation",
      "expression": "Eligible allocation = active order revision with voided rows excluded.",
      "explanation": "Use the current approved snapshot."
    },
    {
      "rule_id": "COUNT-004",
      "title": "Frozen reference",
      "expression": "Frozen sample allocation remains a comparison reference.",
      "explanation": "Compare changes in a separate review."
    }
  ],
