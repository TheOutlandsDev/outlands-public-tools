{
  "name": "outlands-local-site-builder",
  "version": "1.0.1",
  "private": true,
  "description": "Local-only block editor with draft/publish, image assets and verified offline backups.",
  "license": "MIT",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node server.js",
    "setup": "node scripts/setup.js",
    "backup": "node scripts/backup.js",
    "verify-backup": "node scripts/backup.js verify",
    "restore": "node scripts/backup.js restore",
    "export": "node scripts/export.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "source-check": "node scripts/source-check.js",
    "test:browser": "node browser/run.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "multer": "2.5.0",
    "nodemailer": "10.2.1"
  }
}
