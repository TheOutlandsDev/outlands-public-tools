{
  "format": "outlands-component-guide-v1",
  "scope": "Four independently installable wheels and one exact-version collection",
  "path_base": "repository-root",
  "python": ">=3.12,<3.14",
  "terms": "methodology/CONFIGURATION-REVIEW.md",
  "components": [
    {
      "id": "configuration-overlay-planner",
      "purpose": "Plan explicitly ordered fingerprint-only configuration overlays without generating or applying setting values.",
      "use_case": "Review a declared two-layer override while preserving missing required fields and denied replacements.",
      "package": "outlands-configuration-overlay-planner==1.0.0",
      "command": "outlands-configuration-overlay-planner",
      "python_api": "outlands_configuration_overlay_planner.overlays.check(raw_json_bytes)",
      "input_format": "outlands-config-overlays-v1",
      "example_input": "tools/configuration-overlay-planner/examples/input.json",
      "example_review_input": "tools/configuration-overlay-planner/examples/needs-review.json",
      "result_format": "outlands-config-overlays-report-v1",
      "result_fields": [
        "status",
        "counts",
        "issues",
        "execution_authorized",
        "assessment",
        "qualified_scope_sha256",
        "settings_values_validated",
        "runtime_compatibility_verified",
        "adapter_bytes_verified",
        "migration_executed",
        "configuration_changed",
        "effective_configuration_sha256",
        "contract_sha256",
        "layers_sha256",
        "changes_sha256"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Plan explicitly ordered fingerprint-only configuration overlays without generating or applying setting values.",
      "does_not_establish": [
        "Actual setting values or validation",
        "Defaults inserted or configuration files generated",
        "Applied settings or execution authorization"
      ]
    },
    {
      "id": "configuration-contract-diff",
      "purpose": "Describe exact field-metadata changes without inferring breaking changes or runtime compatibility.",
      "use_case": "Explain changed field type, requirement, default fingerprint or constraint fingerprint between selected definitions.",
      "package": "outlands-configuration-contract-diff==1.0.0",
      "command": "outlands-configuration-contract-diff",
      "python_api": "outlands_configuration_contract_diff.contracts.check(raw_json_bytes)",
      "input_format": "outlands-config-contract-diff-v1",
      "example_input": "tools/configuration-contract-diff/examples/input.json",
      "example_review_input": "tools/configuration-contract-diff/examples/needs-review.json",
      "result_format": "outlands-config-contract-diff-report-v1",
      "result_fields": [
        "status",
        "counts",
        "issues",
        "execution_authorized",
        "assessment",
        "qualified_scope_sha256",
        "settings_values_validated",
        "runtime_compatibility_verified",
        "adapter_bytes_verified",
        "migration_executed",
        "configuration_changed",
        "baseline_sha256",
        "candidate_sha256"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Describe exact field-metadata changes without inferring breaking changes or runtime compatibility.",
      "does_not_establish": [
        "Semantic constraint changes or validated defaults",
        "Breaking-change or runtime compatibility inference",
        "Applied contract changes"
      ]
    },
    {
      "id": "compatibility-matrix-checker",
      "purpose": "Check requested symmetric component pairs against exact caller-declared rules.",
      "use_case": "Distinguish an explicitly allowed pair from an unsupported or unlisted pair.",
      "package": "outlands-compatibility-matrix-checker==1.0.0",
      "command": "outlands-compatibility-matrix-checker",
      "python_api": "outlands_compatibility_matrix_checker.matrix.check(raw_json_bytes)",
      "input_format": "outlands-compatibility-matrix-v1",
      "example_input": "tools/compatibility-matrix-checker/examples/input.json",
      "example_review_input": "tools/compatibility-matrix-checker/examples/needs-review.json",
      "result_format": "outlands-compatibility-matrix-report-v1",
      "result_fields": [
        "status",
        "counts",
        "issues",
        "execution_authorized",
        "assessment",
        "qualified_scope_sha256",
        "settings_values_validated",
        "runtime_compatibility_verified",
        "adapter_bytes_verified",
        "migration_executed",
        "configuration_changed",
        "components_sha256",
        "rules_sha256",
        "requirements_sha256"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Check requested symmetric component pairs against exact caller-declared rules.",
      "does_not_establish": [
        "Runtime compatibility or dependency resolution",
        "Unrequested pair coverage or version-range inference",
        "Installed software discovery"
      ]
    },
    {
      "id": "configuration-migration-path-checker",
      "purpose": "Check one explicitly supplied pinned migration chain without opening adapters or running required checks.",
      "use_case": "Find a short, stale, discontinuous or cyclic proposed path before a separate migration decision.",
      "package": "outlands-configuration-migration-path-checker==1.0.0",
      "command": "outlands-configuration-migration-path-checker",
      "python_api": "outlands_configuration_migration_path_checker.migrations.check(raw_json_bytes)",
      "input_format": "outlands-config-migration-path-v1",
      "example_input": "tools/configuration-migration-path-checker/examples/input.json",
      "example_review_input": "tools/configuration-migration-path-checker/examples/needs-review.json",
      "result_format": "outlands-config-migration-path-report-v1",
      "result_fields": [
        "status",
        "counts",
        "issues",
        "execution_authorized",
        "assessment",
        "qualified_scope_sha256",
        "settings_values_validated",
        "runtime_compatibility_verified",
        "adapter_bytes_verified",
        "migration_executed",
        "configuration_changed",
        "contracts_sha256",
        "steps_sha256",
        "source_sha256",
        "target_sha256"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Check one explicitly supplied pinned migration chain without opening adapters or running required checks.",
      "does_not_establish": [
        "Adapter bytes or completed required checks",
        "Route search or safe migration proof",
        "Migration execution or authorization"
      ]
    }
  ],
  "collection": {
    "package": "outlands-configuration-review-collection==1.0.0",
    "command": "outlands-configuration-review",
    "members": [
      "configuration-overlay-planner",
      "configuration-contract-diff",
      "compatibility-matrix-checker",
      "configuration-migration-path-checker"
    ],
    "dependency_rule": "Install all five reviewed wheels from one directory; exact-version dependencies resolve offline."
  },
  "related_systems": [
    {
      "id": "environment-setup-workbench",
      "adapter_status": "not implemented; metadata contracts differ from the value-checker schema and workbench profiles. Explicit field/identity/revision, type/constraint/default, raw-versus-normalized hash, layer precedence, pair-rule and migration/check-evidence mappings are required."
    }
  ]
}
