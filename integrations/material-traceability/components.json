        "inventory_coverage_checked",
        "issues",
        "status",
        "target_changes_performed",
        "transfers_performed",
        "unit"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Consistency of supplied transfer and receipt histories.",
      "does_not_establish": [
        "Physical transfer or delivery",
        "Receipt authenticity or inventory coverage"
      ]
    }
  ],
  "collection": {
    "package": "outlands-material-traceability-collection==1.0.0",
    "command": "outlands-material-traceability",
    "members": [
      "bom-contract-checker",
      "lot-identity-checker",
      "material-allocation-checker",
      "handoff-lifecycle-checker"
    ],
    "dependency_rule": "Install all five reviewed wheels from one directory; exact-version dependencies resolve offline."
  },
  "related_systems": []
}
