{
  "format": "outlands-component-guide-v1",
  "scope": "Four independently installable wheels and one exact-version collection",
  "path_base": "repository-root",
  "python": ">=3.12,<3.14",
  "terms": "methodology/TEST-EVIDENCE.md",
  "components": [
    {
      "id": "test-case-manifest-checker",
      "purpose": "Check that every declared test case has an exact expected-result contract.",
      "use_case": "Prepare a fictional HVAC flow-check case manifest for review.",
      "package": "outlands-test-case-manifest-checker==1.0.0",
      "command": "outlands-test-case-manifest-checker",
      "python_api": "outlands_test_case_manifest_checker.cases.check(raw_json_bytes)",
      "input_format": "outlands-test-case-manifest-v1",
      "example_input": "tools/test-case-manifest-checker/examples/input.json",
      "example_review_input": "tools/test-case-manifest-checker/examples/needs-review.json",
      "result_format": "outlands-test-case-manifest-report-v1",
      "result_fields": [
        "status",
        "issues",
        "assessment",
        "qualified_scope_sha256",
        "cases_sha256"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Check that every declared test case has an exact expected-result contract.",
      "does_not_establish": [
        "Tests executed",
        "Correct expectations",
        "Real code coverage"
      ]
    },
    {
      "id": "test-run-coverage-checker",
      "purpose": "Reconcile planned cases with declared complete observations and exact expected results.",
      "use_case": "Find a missing, timed-out or mismatching observation in a selected run.",
      "package": "outlands-test-run-coverage-checker==1.0.0",
      "command": "outlands-test-run-coverage-checker",
      "python_api": "outlands_test_run_coverage_checker.runs.check(raw_json_bytes)",
      "input_format": "outlands-test-run-coverage-v1",
      "example_input": "tools/test-run-coverage-checker/examples/input.json",
      "example_review_input": "tools/test-run-coverage-checker/examples/needs-review.json",
      "result_format": "outlands-test-run-coverage-report-v1",
      "result_fields": [
        "status",
        "issues",
        "assessment",
        "qualified_scope_sha256",
        "cases_sha256",
        "run_sha256"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Reconcile planned cases with declared complete observations and exact expected results.",
      "does_not_establish": [
        "Authenticated execution",
        "Actual artifact contents",
        "Coverage of undisclosed cases"
      ]
    },
    {
      "id": "regression-comparison-reporter",
      "purpose": "Compare compatible baseline and candidate observations, retaining contract changes and gaps.",
      "use_case": "Distinguish a fictional candidate regression from an incompatible changed test contract.",
      "package": "outlands-regression-comparison-reporter==1.0.0",
      "command": "outlands-regression-comparison-reporter",
      "python_api": "outlands_regression_comparison_reporter.regressions.check(raw_json_bytes)",
      "input_format": "outlands-regression-comparison-v1",
      "example_input": "tools/regression-comparison-reporter/examples/input.json",
      "example_review_input": "tools/regression-comparison-reporter/examples/needs-review.json",
      "result_format": "outlands-regression-comparison-report-v1",
      "result_fields": [
        "status",
        "issues",
        "assessment",
        "qualified_scope_sha256"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Compare compatible baseline and candidate observations, retaining contract changes and gaps.",
      "does_not_establish": [
        "Statistical significance",
        "Compatible changed contracts",
        "Release authorization"
      ]
    },
    {
      "id": "evidence-completeness-checker",
      "purpose": "Check required evidence roles and their exact run, case, result and policy bindings.",
      "use_case": "Check that a fictional failed result has complete declared evidence without upgrading its verdict.",
      "package": "outlands-evidence-completeness-checker==1.0.0",
      "command": "outlands-evidence-completeness-checker",
      "python_api": "outlands_evidence_completeness_checker.evidence.check(raw_json_bytes)",
      "input_format": "outlands-evidence-completeness-v1",
      "example_input": "tools/evidence-completeness-checker/examples/input.json",
      "example_review_input": "tools/evidence-completeness-checker/examples/needs-review.json",
      "result_format": "outlands-evidence-completeness-report-v1",
      "result_fields": [
        "status",
        "issues",
        "assessment",
        "qualified_scope_sha256",
        "cases_sha256",
        "run_sha256",
        "policy_sha256"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Check required evidence roles and their exact run, case, result and policy bindings.",
      "does_not_establish": [
        "Evidence authenticity",
        "Privacy sanitization",
        "Passing test outcomes"
      ]
    }
  ],
  "collection": {
    "package": "outlands-test-evidence-collection==1.0.0",
    "command": "outlands-test-evidence",
    "members": [
      "test-case-manifest-checker",
      "test-run-coverage-checker",
      "regression-comparison-reporter",
      "evidence-completeness-checker"
    ],
    "dependency_rule": "Install all five reviewed wheels from one directory; exact-version dependencies resolve offline."
  },
  "related_systems": [
    {
      "id": "test-evidence-workbench",
      "adapter_status": "not implemented; exact case, expectation, output-normalization, run, result and evidence-policy mapping requires caller review"
    }
  ]
}
