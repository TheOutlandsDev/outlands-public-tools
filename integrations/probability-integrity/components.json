{
  "format": "outlands-component-guide-v1",
  "scope": "Four independently installable wheels and one exact-version collection",
  "path_base": "repository-root",
  "python": ">=3.12,<3.14",
  "terms": "methodology/PROBABILITY.md",
  "components": [
    {
      "id": "probability-vector-checker",
      "purpose": "Check the declared classes, bounds and exact total of each probability vector.",
      "use_case": "Check four fictional HVAC fault/no-fault vectors before a project selects a positive-class value.",
      "package": "outlands-probability-vector-checker==1.0.0",
      "command": "outlands-probability-vector-checker",
      "python_api": "outlands_probability_vector_checker.vectors.check(raw_json_bytes)",
      "input_format": "outlands-probability-vector-v1",
      "example_input": "tools/probability-vector-checker/examples/input.json",
      "example_review_input": "tools/probability-vector-checker/examples/needs-review.json",
      "result_format": "outlands-probability-vector-report-v1",
      "result_fields": [
        "assessment",
        "issues",
        "status"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Check the declared classes, bounds and exact total of each probability vector.",
      "does_not_establish": [
        "Model inference",
        "Probability calibration",
        "Outcome truth"
      ]
    },
    {
      "id": "binary-probability-error-calculator",
      "purpose": "Calculate squared probability error against supplied binary outcomes for the full cohort.",
      "use_case": "Review exact errors on four invented HVAC cases with supplied outcomes.",
      "package": "outlands-binary-probability-error-calculator==1.0.0",
      "command": "outlands-binary-probability-error-calculator",
      "python_api": "outlands_binary_probability_error_calculator.errors.check(raw_json_bytes)",
      "input_format": "outlands-binary-probability-error-v1",
      "example_input": "tools/binary-probability-error-calculator/examples/input.json",
      "example_review_input": "tools/binary-probability-error-calculator/examples/needs-review.json",
      "result_format": "outlands-binary-probability-error-report-v1",
      "result_fields": [
        "assessment",
        "evaluation_sha256",
        "issues",
        "metrics",
        "status"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Calculate squared probability error against supplied binary outcomes for the full cohort.",
      "does_not_establish": [
        "Outcome truth",
        "Independent evaluation",
        "Model quality"
      ]
    },
    {
      "id": "reliability-bin-reporter",
      "purpose": "Summarize supplied predictions and outcomes in caller-selected fixed bins.",
      "use_case": "Inspect three fixed ranges for the same fictional cases while keeping empty bins visible.",
      "package": "outlands-reliability-bin-reporter==1.0.0",
      "command": "outlands-reliability-bin-reporter",
      "python_api": "outlands_reliability_bin_reporter.bins.check(raw_json_bytes)",
      "input_format": "outlands-reliability-bins-v1",
      "example_input": "tools/reliability-bin-reporter/examples/input.json",
      "example_review_input": "tools/reliability-bin-reporter/examples/needs-review.json",
      "result_format": "outlands-reliability-bin-report-v1",
      "result_fields": [
        "assessment",
        "bin_assessment",
        "issues",
        "metrics",
        "report_sha256",
        "status"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Summarize supplied predictions and outcomes in caller-selected fixed bins.",
      "does_not_establish": [
        "Statistical significance",
        "Calibration proof",
        "Automatic bin selection"
      ]
    },
    {
      "id": "calibration-map-checker",
      "purpose": "Review the shape and revision of a declared piecewise-linear probability map.",
      "use_case": "Review a fictional identity map and a changed midpoint before any separate application decision.",
      "package": "outlands-calibration-map-checker==1.0.0",
      "command": "outlands-calibration-map-checker",
      "python_api": "outlands_calibration_map_checker.maps.check(raw_json_bytes)",
      "input_format": "outlands-calibration-map-v1",
      "example_input": "tools/calibration-map-checker/examples/input.json",
      "example_review_input": "tools/calibration-map-checker/examples/needs-review.json",
      "result_format": "outlands-calibration-map-report-v1",
      "result_fields": [
        "assessment",
        "issues",
        "map_assessments",
        "status"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Review the shape and revision of a declared piecewise-linear probability map.",
      "does_not_establish": [
        "Map fitting or application",
        "Model updates",
        "Improved calibration"
      ]
    }
  ],
  "collection": {
    "package": "outlands-probability-integrity-collection==1.0.0",
    "command": "outlands-probability-integrity",
    "members": [
      "probability-vector-checker",
      "binary-probability-error-calculator",
      "reliability-bin-reporter",
      "calibration-map-checker"
    ],
    "dependency_rule": "Install all five reviewed wheels from one directory; exact-version dependencies resolve offline."
  },
  "related_systems": [
    {
      "id": "ml-experiment-workbench",
      "adapter_status": "not implemented; explicit decimal and identity mapping required"
    }
  ]
}
