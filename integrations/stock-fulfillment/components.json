      "package": "outlands-stock-movement-ledger-checker==1.0.0",
      "command": "outlands-stock-movement-ledger-checker",
      "python_api": "outlands_stock_movement_ledger_checker.movements.check(raw_json_bytes)",
      "input_format": "outlands-stock-movements-v1",
      "example_input": "tools/stock-movement-ledger-checker/examples/input.json",
      "example_review_input": "tools/stock-movement-ledger-checker/examples/needs-review.json",
      "result_format": "outlands-stock-movements-report-v1",
      "result_fields": [
        "as_of",
        "assessment",
        "content_privacy_verified",
        "counts",
        "declarations_independently_verified",
        "delivery_verified",
        "execution_authorized",
        "format",
        "inbound_eligibility_verified",
        "input_sha256",
        "issues",
        "movements_sha256",
        "physical_stock_verified",
        "procurement_authorized",
        "purchase_order_created",
        "qualified_scope_sha256",
        "records_changed",
        "reservations_changed",
        "shipment_executed",
        "status",
        "stock_updated",
        "stocks_sha256",
        "target_changes_performed"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Supplied balance history and closing quantity.",
      "does_not_establish": [
        "Physical stock count",
        "Stock transaction posting"
      ]
