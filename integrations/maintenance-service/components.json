        "target_changes_performed"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Consistency of supplied tasks, parts accounting and evidence declarations against a pinned order.",
      "does_not_establish": [
        "Evidence bytes or physical service",
        "Service approval, stock or order updates"
      ]
    }
  ],
  "collection": {
    "package": "outlands-maintenance-service-collection==1.0.0",
    "command": "outlands-maintenance-service",
    "members": [
