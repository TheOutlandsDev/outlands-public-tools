        "execution_authorized",
        "format",
        "input_sha256",
        "issues",
        "orders",
        "orders_changed",
        "service_work_verified",
        "status",
        "target_changes_performed"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Consistency of supplied order snapshot with its explicit event history.",
      "does_not_establish": [
        "Physical service work or completion evidence",
        "Dispatch or order updates"
      ]
    },
    {
      "id": "service-completion-checker",
      "purpose": "Reconcile declared tasks, parts and evidence against exact work-order snapshots.",
      "use_case": "Review fictional service completion under a pinned order and task contract.",
      "package": "outlands-service-completion-checker==1.0.0",
      "command": "outlands-service-completion-checker",
      "python_api": "outlands_service_completion_checker.completion.check(raw_json_bytes)",
      "input_format": "outlands-service-completion-v1",
