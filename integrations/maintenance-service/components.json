{
  "format": "outlands-component-guide-v1",
  "scope": "Four independently installable wheels and one exact-version collection",
  "path_base": "repository-root",
  "python": ">=3.12,<3.14",
  "terms": "methodology/MAINTENANCE-SERVICE.md",
  "components": [
    {
      "id": "meter-history-checker",
      "purpose": "Check supplied meter readings and reset boundaries without collecting live readings.",
      "use_case": "Review a fictional blower-meter history with an explicit reset.",
      "package": "outlands-meter-history-checker==1.0.0",
      "command": "outlands-meter-history-checker",
      "python_api": "outlands_meter_history_checker.meters.check(raw_json_bytes)",
      "input_format": "outlands-meter-history-v1",
      "example_input": "tools/meter-history-checker/examples/input.json",
      "example_review_input": "tools/meter-history-checker/examples/needs-review.json",
      "result_format": "outlands-meter-history-review-v1",
      "result_fields": [
        "content_privacy_verified",
        "counters_changed",
        "counts",
        "declarations_independently_verified",
        "execution_authorized",
        "format",
        "input_sha256",
        "issues",
        "live_reading_collected",
        "physical_counter_verified",
        "snapshots",
        "status",
        "target_changes_performed"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Consistent ordered supplied readings and computed cumulative usage.",
      "does_not_establish": [
        "Physical counter accuracy",
        "Live meter collection or counter updates"
      ]
    },
    {
      "id": "maintenance-due-planner",
      "purpose": "Calculate advisory due states from supplied time and usage intervals without scheduling.",
      "use_case": "Review a fictional filter-service plan against declared as-of and usage.",
      "package": "outlands-maintenance-due-planner==1.0.0",
      "command": "outlands-maintenance-due-planner",
      "python_api": "outlands_maintenance_due_planner.due.check(raw_json_bytes)",
      "input_format": "outlands-maintenance-due-v1",
      "example_input": "tools/maintenance-due-planner/examples/input.json",
      "example_review_input": "tools/maintenance-due-planner/examples/needs-review.json",
      "result_format": "outlands-maintenance-due-review-v1",
      "result_fields": [
        "as_of",
        "assessments",
        "content_privacy_verified",
        "counts",
        "declarations_independently_verified",
        "execution_authorized",
        "format",
        "input_sha256",
        "interval_suitability_verified",
        "issues",
        "live_clock_used",
        "meter_sources_verified",
        "schedule_created",
        "service_performed",
        "status",
        "target_changes_performed"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Due state under selected supplied intervals, clock ordinal and meter totals.",
      "does_not_establish": [
        "Interval suitability or actual meter provenance",
        "A created schedule or performed service"
      ]
    },
    {
      "id": "work-order-lifecycle-checker",
      "purpose": "Review declared work-order revisions and state transitions without dispatch.",
