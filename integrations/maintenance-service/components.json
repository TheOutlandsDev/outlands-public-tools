      "package": "outlands-work-order-lifecycle-checker==1.0.0",
      "command": "outlands-work-order-lifecycle-checker",
      "python_api": "outlands_work_order_lifecycle_checker.orders.check(raw_json_bytes)",
      "input_format": "outlands-work-order-lifecycle-v1",
