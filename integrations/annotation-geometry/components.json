{
  "format": "outlands-component-guide-v1",
  "scope": "Four independently installable wheels and one exact-version collection",
  "path_base": "repository-root",
  "python": ">=3.12,<3.14",
  "terms": "methodology/ANNOTATION-GEOMETRY.md",
  "components": [
    {
      "id": "annotation-manifest-checker",
      "purpose": "Check declared image, taxonomy and annotation snapshot references without opening image assets.",
      "use_case": "Review a fictional image and label manifest before geometry checks.",
      "package": "outlands-annotation-manifest-checker==1.0.0",
      "command": "outlands-annotation-manifest-checker",
      "python_api": "outlands_annotation_manifest_checker.manifest.check(raw_json_bytes)",
      "input_format": "outlands-annotation-manifest-v1",
      "example_input": "tools/annotation-manifest-checker/examples/input.json",
      "example_review_input": "tools/annotation-manifest-checker/examples/needs-review.json",
      "result_format": "outlands-annotation-manifest-report-v1",
      "result_fields": [
        "annotations_sha256",
        "approval_authenticity_verified",
        "artifact_bytes_verified",
        "assessment",
        "content_geometry_alignment_verified",
        "content_privacy_verified",
        "counts",
        "dataset_export_performed",
        "declarations_independently_verified",
        "execution_authorized",
        "format",
        "geometry_verified",
        "images_sha256",
        "input_sha256",
        "issues",
        "label_truth_verified",
        "status",
        "target_changes_performed",
        "taxonomy_sha256"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Internal consistency of selected image, taxonomy and annotation references and normalized pins.",
      "does_not_establish": [
        "Actual image bytes or label truth",
        "Polygon geometric validity"
      ]
    },
    {
      "id": "polygon-geometry-checker",
      "purpose": "Check simple polygon geometry with bounded exact integer arithmetic.",
      "use_case": "Review fictional polygon boundaries against supplied image dimensions.",
      "package": "outlands-polygon-geometry-checker==1.0.0",
      "command": "outlands-polygon-geometry-checker",
      "python_api": "outlands_polygon_geometry_checker.polygons.check(raw_json_bytes)",
      "input_format": "outlands-polygon-geometry-v1",
      "example_input": "tools/polygon-geometry-checker/examples/input.json",
      "example_review_input": "tools/polygon-geometry-checker/examples/needs-review.json",
      "result_format": "outlands-polygon-geometry-report-v1",
      "result_fields": [
        "approval_authenticity_verified",
        "artifact_bytes_verified",
        "assessment",
        "content_geometry_alignment_verified",
        "content_privacy_verified",
        "counts",
        "dataset_export_performed",
        "declarations_independently_verified",
        "execution_authorized",
        "format",
        "geometry_repaired",
        "images_sha256",
        "input_sha256",
        "issues",
        "label_truth_verified",
        "polygons_sha256",
        "status",
        "target_changes_performed"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Geometric findings for supplied vertices and declared dimensions.",
      "does_not_establish": [
        "Image content or pixel alignment",
        "Automatic repair or label truth"
      ]
    },
    {
      "id": "bounding-box-converter",
      "purpose": "Convert declared box conventions using exact fractions without clipping or rounding.",
      "use_case": "Review fictional pixel and normalized boxes before format handoff.",
      "package": "outlands-bounding-box-converter==1.0.0",
      "command": "outlands-bounding-box-converter",
      "python_api": "outlands_bounding_box_converter.boxes.check(raw_json_bytes)",
      "input_format": "outlands-bounding-box-conversion-v1",
      "example_input": "tools/bounding-box-converter/examples/input.json",
      "example_review_input": "tools/bounding-box-converter/examples/needs-review.json",
      "result_format": "outlands-bounding-box-conversion-report-v1",
      "result_fields": [
        "approval_authenticity_verified",
        "artifact_bytes_verified",
        "assessment",
        "boxes_sha256",
        "content_geometry_alignment_verified",
        "content_privacy_verified",
        "coordinates_clipped",
        "coordinates_rounded",
        "counts",
        "dataset_export_performed",
        "declarations_independently_verified",
        "execution_authorized",
        "format",
        "images_sha256",
        "input_sha256",
        "issues",
        "label_truth_verified",
        "status",
        "target_changes_performed"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Exact conversion of selected declared box coordinates and formats.",
      "does_not_establish": [
        "Image content or asset updates",
        "Clipping, rounding or external format compatibility"
      ]
    },
    {
      "id": "annotation-export-handoff-checker",
      "purpose": "Reconcile selected annotations, category mappings, approvals and expected counts.",
      "use_case": "Review a fictional annotation selection before a separate export.",
      "package": "outlands-annotation-export-handoff-checker==1.0.0",
      "command": "outlands-annotation-export-handoff-checker",
      "python_api": "outlands_annotation_export_handoff_checker.handoff.check(raw_json_bytes)",
      "input_format": "outlands-annotation-export-handoff-v1",
      "example_input": "tools/annotation-export-handoff-checker/examples/input.json",
      "example_review_input": "tools/annotation-export-handoff-checker/examples/needs-review.json",
      "result_format": "outlands-annotation-export-handoff-report-v1",
      "result_fields": [
        "annotations_sha256",
        "approval_authenticity_verified",
        "artifact_bytes_verified",
        "assessment",
        "categories_sha256",
        "content_geometry_alignment_verified",
        "content_privacy_verified",
        "counts",
        "dataset_export_performed",
        "declarations_independently_verified",
        "execution_authorized",
        "format",
        "geometry_verified",
        "handoff_sha256",
        "images_sha256",
        "input_sha256",
        "issues",
        "label_truth_verified",
        "selected_annotations_sha256",
        "status",
        "target_changes_performed",
        "taxonomy_sha256"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Consistency of supplied pins, selections, category mapping and expected counts.",
      "does_not_establish": [
        "Actual dataset export",
        "Approval authenticity, geometry validity or label truth"
      ]
    }
  ],
  "collection": {
    "package": "outlands-annotation-geometry-collection==1.0.0",
    "command": "outlands-annotation-geometry",
    "members": [
      "annotation-manifest-checker",
      "polygon-geometry-checker",
      "bounding-box-converter",
      "annotation-export-handoff-checker"
    ],
    "dependency_rule": "Install all five reviewed wheels from one directory; exact-version dependencies resolve offline."
  },
  "related_systems": []
}
