{
  "format": "outlands-component-guide-v1",
  "scope": "Four independently installable wheels and one exact-version collection",
  "path_base": "repository-root",
  "python": ">=3.12,<3.14",
  "terms": "methodology/METRICS-TRACES.md",
  "components": [
    {
      "id": "metric-definition-contract-checker",
      "purpose": "Validate declared metric kinds, units, labels, limits and exact selected series bindings.",
      "use_case": "Define the invented jobs, queue depth and preview latency series for a report run.",
      "package": "outlands-metric-definition-contract-checker==1.0.0",
      "command": "outlands-metric-definition-contract-checker",
      "python_api": "outlands_metric_definition_contract_checker.definitions.check(raw_json_bytes)",
      "input_format": "outlands-metric-definitions-v1",
      "example_input": "tools/metric-definition-contract-checker/examples/input.json",
      "example_review_input": "tools/metric-definition-contract-checker/examples/needs-review.json",
      "result_format": "outlands-metric-definitions-report-v1",
      "result_fields": [
        "status",
        "issues",
        "assessment",
        "qualified_scope_sha256",
        "definitions_sha256",
        "series_sha256"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Validate declared metric kinds, units, labels, limits and exact selected series bindings.",
      "does_not_establish": [
        "Actual telemetry or instrumentation",
        "Physical unit semantics",
        "Production metric design"
      ]
    },
    {
      "id": "metric-snapshot-reconciler",
      "purpose": "Reconcile supplied scalar and disjoint histogram snapshots with required series/run coverage.",
      "use_case": "Find a missing required point or a mismatch between histogram buckets and count.",
      "package": "outlands-metric-snapshot-reconciler==1.0.0",
      "command": "outlands-metric-snapshot-reconciler",
      "python_api": "outlands_metric_snapshot_reconciler.snapshots.check(raw_json_bytes)",
      "input_format": "outlands-metric-snapshots-v1",
      "example_input": "tools/metric-snapshot-reconciler/examples/input.json",
      "example_review_input": "tools/metric-snapshot-reconciler/examples/needs-review.json",
      "result_format": "outlands-metric-snapshots-report-v1",
      "result_fields": [
        "status",
        "issues",
        "assessment",
        "qualified_scope_sha256",
        "definitions_sha256",
        "series_sha256",
        "runs_sha256",
        "points_sha256"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Reconcile supplied scalar and disjoint histogram snapshots with required series/run coverage.",
      "does_not_establish": [
        "Underlying observations",
        "Actual monitoring coverage or freshness",
        "Histogram sample membership or nonempty sum feasibility"
      ]
    },
    {
      "id": "trace-structure-checker",
      "purpose": "Validate selected span graphs, declared intervals and expected trace coverage.",
      "use_case": "Review an invented report operation with a root span and two overlapping child spans.",
      "package": "outlands-trace-structure-checker==1.0.0",
      "command": "outlands-trace-structure-checker",
      "python_api": "outlands_trace_structure_checker.traces.check(raw_json_bytes)",
      "input_format": "outlands-trace-structure-v1",
      "example_input": "tools/trace-structure-checker/examples/input.json",
      "example_review_input": "tools/trace-structure-checker/examples/needs-review.json",
      "result_format": "outlands-trace-structure-report-v1",
      "result_fields": [
        "status",
        "issues",
        "assessment",
        "qualified_scope_sha256",
        "runs_sha256",
        "traces_sha256",
        "spans_sha256"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Validate selected span graphs, declared intervals and expected trace coverage.",
      "does_not_establish": [
        "Actual trace completeness",
        "Parent containment or causal ordering",
        "Synchronized clocks"
      ]
    },
    {
      "id": "metric-trace-correlation-checker",
      "purpose": "Recompute metric/trace source contracts and check explicit point/span run and time links.",
      "use_case": "Check whether an explicitly selected latency point falls inside its pinned preview span.",
      "package": "outlands-metric-trace-correlation-checker==1.0.0",
      "command": "outlands-metric-trace-correlation-checker",
      "python_api": "outlands_metric_trace_correlation_checker.correlations.check(raw_json_bytes)",
      "input_format": "outlands-metric-trace-correlations-v1",
      "example_input": "tools/metric-trace-correlation-checker/examples/input.json",
      "example_review_input": "tools/metric-trace-correlation-checker/examples/needs-review.json",
      "result_format": "outlands-metric-trace-correlations-report-v1",
      "result_fields": [
        "status",
        "issues",
        "assessment",
        "qualified_scope_sha256",
        "definitions_sha256",
        "series_sha256",
        "runs_sha256",
        "points_sha256",
        "traces_sha256",
        "spans_sha256",
        "requirements_sha256",
        "links_sha256"
      ],
      "dependencies": [
        "Python 3.12 or 3.13"
      ],
      "establishes": "Recompute metric/trace source contracts and check explicit point/span run and time links.",
      "does_not_establish": [
        "Causation or semantic relationship",
        "Actual observations or latency",
        "Protocol/exporter compatibility"
      ]
    }
  ],
  "collection": {
    "package": "outlands-metrics-traces-collection==1.0.0",
    "command": "outlands-metrics-traces",
    "members": [
      "metric-definition-contract-checker",
      "metric-snapshot-reconciler",
      "trace-structure-checker",
      "metric-trace-correlation-checker"
    ],
    "dependency_rule": "Install all five reviewed wheels from one directory; exact-version dependencies resolve offline."
  },
  "related_systems": [
    {
      "id": "data-services-stack",
      "adapter_status": "not implemented; caller-owned metric definitions, units, run/revision/clock mapping and independently supplied trace records require review"
    }
  ]
}
