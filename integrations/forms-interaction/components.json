{
  "format": "outlands-component-guide-v1",
  "scope": "Four independently installable wheels and one exact-version collection",
  "path_base": "repository-root",
  "python": ">=3.12,<3.14",
  "terms": "methodology/FORMS-INTERACTION.md",
  "components": [
    {
      "id": "form-definition-contract-checker",
      "purpose": "Check bounded field declarations, conditional rules and form identity without opening a browser.",
      "use_case": "Review a fictional service-request form before collecting examples.",
      "package": "outlands-form-definition-contract-checker==1.0.0",
      "command": "outlands-form-definition-contract-checker",
      "python_api": "outlands_form_definition_contract_checker.forms.check(raw_json_bytes)",
      "input_format": "outlands-form-definitions-v1",
      "example_input": "tools/form-definition-contract-checker/examples/input.json",
      "example_review_input": "tools/form-definition-contract-checker/examples/needs-review.json",
      "result_format": "outlands-form-definitions-report-v1",
      "result_fields": ["accessibility_verified", "assessment", "authentication_performed", "browser_started", "content_privacy_verified", "counts", "declarations_independently_verified", "dom_inspected", "execution_authorized", "format", "forms_sha256", "input_sha256", "issues", "network_requests_performed", "qualified_scope_sha256", "raw_values_emitted", "records_changed", "scripts_executed", "status", "target_changes_performed", "whole_ui_compatibility_verified"],
      "dependencies": ["Python 3.12 or 3.13"],
      "establishes": "Internal consistency of the supplied bounded form definition and its normalized fingerprint.",
      "does_not_establish": ["Browser rendering or accessibility", "HTML validation or implementation behavior"]
