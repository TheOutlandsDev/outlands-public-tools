      "dependencies": ["Python 3.12 or 3.13"],
      "establishes": "Equality or change for the selected supplied cases under their exact declared versions.",
      "does_not_establish": ["Whole-UI compatibility or untested-case behavior", "DOM, accessibility or actual browser behavior"]
