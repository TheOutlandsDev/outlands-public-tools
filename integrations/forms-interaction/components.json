      "does_not_establish": ["That a browser interaction occurred", "Actual approval, identity or authorization"]
    },
    {
      "id": "ui-interaction-scenario-comparator",
      "purpose": "Compare identical supplied form and interaction cases across two independently compiled versions.",
      "use_case": "Review whether tightening a declared field rule changes selected fictional submission and flow outcomes.",
      "package": "outlands-ui-interaction-scenario-comparator==1.0.0",
