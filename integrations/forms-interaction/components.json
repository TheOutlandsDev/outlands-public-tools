      "example_review_input": "tools/ui-transition-history-checker/examples/needs-review.json",
      "result_format": "outlands-ui-histories-report-v1",
      "result_fields": ["accessibility_verified", "assessment", "authentication_performed", "browser_started", "content_privacy_verified", "counts", "declarations_independently_verified", "dom_inspected", "execution_authorized", "flows_sha256", "format", "forms_sha256", "histories_sha256", "input_sha256", "issues", "network_requests_performed", "qualified_scope_sha256", "raw_values_emitted", "records_changed", "scripts_executed", "status", "submissions_sha256", "target_changes_performed", "whole_ui_compatibility_verified"],
      "dependencies": ["Python 3.12 or 3.13"],
