      "example_review_input": "tools/form-submission-contract-checker/examples/needs-review.json",
      "result_format": "outlands-form-submissions-report-v1",
      "result_fields": ["accessibility_verified", "assessment", "authentication_performed", "browser_started", "content_privacy_verified", "counts", "declarations_independently_verified", "dom_inspected", "execution_authorized", "format", "forms_sha256", "input_sha256", "issues", "network_requests_performed", "qualified_scope_sha256", "raw_values_emitted", "records_changed", "scripts_executed", "status", "submissions_sha256", "target_changes_performed", "whole_ui_compatibility_verified"],
